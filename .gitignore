# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor state
.opencode/
.opencode
.claude/

# design-tool scratch (decision-page logs, live-mode session state).
# design.json is the DESIGN.md sidecar and belongs in the repo.
# (must ignore the contents, not the directory — git cannot re-include a
# file inside an excluded directory)
.impeccable/*
!.impeccable/design.json

# playwright artifacts
/test-results/
/playwright-report/
